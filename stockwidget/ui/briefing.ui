     <widget class="QWidget" name="chatPage">
      <attribute name="title">
       <string>使用ChatGPT分析</string>
      </attribute>
      <layout class="QVBoxLayout" name="chatPageLayout">
       <item>
        <widget class="QLabel" name="chatNotice">
         <property name="text">
          <string>本软件不调用付费API，也不能直接消耗Plus会员额度。复制后由你到自己登录的ChatGPT粘贴；不会自动上传，不读取账号、Cookie或验证码。ChatGPT可用模型及次数以你的会员页面为准。</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="privateCheck">
         <property name="text">
          <string>主动包含成本、持股数量、锁定/策略仓、组合盈亏及个人提醒（记住选择，可随时关闭）</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="privacyStateLabel">
         <property name="text">
          <string>未包含持仓（默认）；可主动选择并记住偏好</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="chatActions">
         <item>
